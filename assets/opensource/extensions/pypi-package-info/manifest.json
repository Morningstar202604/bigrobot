{
 "id": "pypi-package-info",
 "name": "PyPI 包信息",
 "version": "0.0.1",
 "base_url": "https://pypi.org",
 "description": "PyPI JSON API（公开包元数据，无需 Key）。",
 "tools": [
  {
   "name": "pypi_package_info",
   "description": "读取 Python 包的版本、摘要、主页和许可证。",
   "method": "GET",
   "path": "/pypi/{name}/json",
   "risk": "read",
   "params": {
    "name": {
     "type": "string",
     "required": true,
     "in": "path",
     "description": "包名，如 fastapi"
    }
   },
   "format": "pypi"
  }
 ],
 "skills": [
  {
   "name": "Python 包尽调",
   "description": "查 PyPI 元数据再决定是否引入",
   "file": "skills/pypi.md"
  }
 ],
 "allow_private": true,
 "allow_untrusted": true
}
